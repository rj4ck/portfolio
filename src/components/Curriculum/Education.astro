---
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const TRANSLATION_KEY_BY_FILE: Record<string, string> = {
  eadic: "EADIC",
  seda: "SEDA",
  ujn: "UJN",
  "unir-master": "UNIR",
};

const items = await Astro.glob("../../content/education/*.md");
const sorted = items.sort((a, b) => a.frontmatter.order - b.frontmatter.order);
---

<div class="mt-1 space-y-2">
  {
    sorted.map((item) => {
      const { school, startDate, endDate } = item.frontmatter;
      const fileId = item.file.split("/").pop()?.replace(/\.md$/, "") ?? "";
      const translationKey = TRANSLATION_KEY_BY_FILE[fileId];
      const title = translationKey
        ? t(`CURRICULUM.EDUCATION.${translationKey}.TITLE` as any)
        : item.frontmatter.title;
      const location = translationKey
        ? t(`CURRICULUM.EDUCATION.${translationKey}.LOCATION` as any)
        : item.frontmatter.location;
      const dateRange = endDate
        ? `${startDate} — ${endDate}`
        : `${startDate} — ${t("CURRICULUM.DATE.PRESENT")}`;
      return (
        <div class="flex items-start justify-between gap-4 py-1.5 border-b border-gray-100 last:border-0">
          <div class="min-w-0">
            <p class="text-xs font-semibold text-gray-800 leading-snug">{title}</p>
            <p class="text-[11px] text-orange-500 font-medium mt-0.5">{school}</p>
            <p class="text-[10px] text-gray-400 mt-0.5">{location}</p>
          </div>
          <p class="text-[10px] text-gray-400 whitespace-nowrap shrink-0 mt-0.5">{dateRange}</p>
        </div>
      );
    })
  }
</div>
