---
import Divider from "./Divider.astro";
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="text-gray-100 py-12">
  <div class="max-w-screen-xl pb-10">
    <h2 class="text-3xl font-bold sm:text-4xl">{title}</h2>
  </div>

  <slot />

  <Divider />
</section>
