---
interface Props {
  date: string;
  title: string;
  subtitle: string;
  startDate?: string;
  endDate?: string;
  location: string;
  showTimeline?: boolean;
}

const { date, title, subtitle, startDate, endDate, location, showTimeline = true } = Astro.props;
const dateRange = `${startDate}${endDate ? ` — ${endDate}` : " — Present"}`;
---

{
  showTimeline ? (
    <div class="relative mt-2 pb-0">
      <div class="md:flex items-center md:space-x-4 mb-0">
        <div class="flex items-center space-x-4 md:space-x-2 md:space-x-reverse">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-gray-800 border border-gray-700 shadow md:order-1">
            <slot name="icon" />
          </div>
          <time class="font-caveat font-medium text-sm text-orange-500 md:w-28">{date}</time>
        </div>
        <div class="ml-14">
          <p class="text-xl">{subtitle}</p>
          <p class="text-orange-400">{title}</p>
        </div>
      </div>
      <div class="p-2 bg-gray-800 text-gray-400 rounded-md border border-gray-700 shadow ml-14 md:ml-44">
        <slot />
      </div>
    </div>
  ) : (
    <div class="relative">
      <div class="flex items-start justify-between gap-4 mb-1.5">
        <div>
          <p class="text-sm font-bold text-gray-900 leading-snug">{subtitle}</p>
          <p class="text-xs font-semibold text-orange-500 mt-0.5">{title}</p>
        </div>
        <div class="text-right shrink-0">
          <p class="text-[10px] text-gray-400 whitespace-nowrap">{dateRange}</p>
          <p class="text-[10px] text-gray-400 whitespace-nowrap">{location}</p>
        </div>
      </div>
      <slot />
    </div>
  )
}
