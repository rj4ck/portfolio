---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;
const enPath = currentPath.replace(/\/(en|es)(\/|$)/, "/en$2");
const esPath = currentPath.replace(/\/(en|es)(\/|$)/, "/es$2");
---

<div
  class="fixed top-4 right-4 z-50 flex items-center rounded-lg border border-gray-700 bg-gray-900/90 backdrop-blur-sm overflow-hidden text-xs font-semibold shadow-lg print:hidden"
>
  <a
    href={enPath}
    aria-label="Switch to English"
    class={`px-3 py-1.5 transition-colors duration-200 ${lang === "en" ? "bg-orange-500 text-white" : "text-gray-400 hover:text-white"}`}
  >
    EN
  </a>
  <span class="w-px h-4 bg-gray-700 shrink-0"></span>
  <a
    href={esPath}
    aria-label="Cambiar a Español"
    class={`px-3 py-1.5 transition-colors duration-200 ${lang === "es" ? "bg-orange-500 text-white" : "text-gray-400 hover:text-white"}`}
  >
    ES
  </a>
</div>
