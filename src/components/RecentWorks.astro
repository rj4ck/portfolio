---
import CodexIcon from "./icons/CodexIcon.tsx";
import ClinpaysIcon from "./icons/ClinpaysIcon.tsx";
import WorkDetail from "./WorkDetail.astro";
import ProjectList from "./ProjectList.astro";
import TimeLine from "./TimeLine.astro";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang?: string;
  showTimeline?: boolean;
}

const { lang = "en", showTimeline } = Astro.props;
const t = useTranslations(lang as "en" | "es");

// showTimeline=undefined means portfolio (full detail view)
// showTimeline=false means curriculum (compact bullets)
const isPortfolio = showTimeline !== false;

const labels = {
  context:       t("RECENT_WORKS.SECTION.CONTEXT"),
  role:          t("RECENT_WORKS.SECTION.ROLE"),
  contributions: t("RECENT_WORKS.SECTION.CONTRIBUTIONS"),
  challenges:    t("RECENT_WORKS.SECTION.CHALLENGES"),
  results:       t("RECENT_WORKS.SECTION.RESULTS"),
};
---

<div
  class={`space-y-8 relative ${isPortfolio ? "before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:ml-[8.75rem] md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-gray-600 before:to-transparent" : ""}`}
>

  <!-- Code ÉXITOS — Software Engineer 2 -->
  <TimeLine
    showTimeline={isPortfolio}
    startDate="10/2024"
    location="Austin, Texas"
    date="Oct 2024"
    title="Code ÉXITOS"
    subtitle="Software Engineer 2"
  >
    <CodexIcon slot="icon" />
    {isPortfolio ? (
      <WorkDetail
        context={t("RECENT_WORKS.CODEX_2.CONTEXT")}
        role={t("RECENT_WORKS.CODEX_2.ROLE")}
        contributions={[
          t("RECENT_WORKS.CODEX_2.1"),
          t("RECENT_WORKS.CODEX_2.2"),
          t("RECENT_WORKS.CODEX_2.3"),
          t("RECENT_WORKS.CODEX_2.4"),
          t("RECENT_WORKS.CODEX_2.5"),
        ]}
        challenges={[
          t("RECENT_WORKS.CODEX_2.CHALLENGE.1"),
          t("RECENT_WORKS.CODEX_2.CHALLENGE.2"),
          t("RECENT_WORKS.CODEX_2.CHALLENGE.3"),
        ]}
        results={[
          t("RECENT_WORKS.CODEX_2.RESULT.1"),
          t("RECENT_WORKS.CODEX_2.RESULT.2"),
          t("RECENT_WORKS.CODEX_2.RESULT.3"),
        ]}
        tags={["VueJS", "NuxtJS", ".NET", "ASPX", "Figma", "Lovable"]}
        {labels}
      />
    ) : (
      <ProjectList
        showTimeline={false}
        title=""
        details={[
          t("RECENT_WORKS.CODEX_2.1"),
          t("RECENT_WORKS.CODEX_2.2"),
          t("RECENT_WORKS.CODEX_2.3"),
          t("RECENT_WORKS.CODEX_2.4"),
          t("RECENT_WORKS.CODEX_2.5"),
        ]}
      />
    )}
  </TimeLine>

  <!-- Code ÉXITOS — Software Developer -->
  <TimeLine
    showTimeline={isPortfolio}
    startDate="02/2022"
    endDate="01/2024"
    location="San Pedro Sula, Honduras"
    date="Feb 2022"
    title="Code ÉXITOS"
    subtitle="Software Developer"
  >
    <CodexIcon slot="icon" />
    {isPortfolio ? (
      <WorkDetail
        context={t("RECENT_WORKS.CODEX.CONTEXT")}
        role={t("RECENT_WORKS.CODEX.ROLE")}
        contributions={[
          t("RECENT_WORKS.CODEX.1"),
          t("RECENT_WORKS.CODEX.2"),
          t("RECENT_WORKS.CODEX.3"),
          t("RECENT_WORKS.CODEX.4"),
          t("RECENT_WORKS.CODEX.5"),
        ]}
        challenges={[
          t("RECENT_WORKS.CODEX.CHALLENGE.1"),
          t("RECENT_WORKS.CODEX.CHALLENGE.2"),
          t("RECENT_WORKS.CODEX.CHALLENGE.3"),
        ]}
        results={[
          t("RECENT_WORKS.CODEX.RESULT.1"),
          t("RECENT_WORKS.CODEX.RESULT.2"),
          t("RECENT_WORKS.CODEX.RESULT.3"),
        ]}
        tags={["React Native", "GitHub Actions", "AWS ECS", "Kubernetes", "NestJS", "Python"]}
        {labels}
      />
    ) : (
      <ProjectList
        showTimeline={false}
        title=""
        details={[
          t("RECENT_WORKS.CODEX.1"),
          t("RECENT_WORKS.CODEX.2"),
          t("RECENT_WORKS.CODEX.3"),
          t("RECENT_WORKS.CODEX.4"),
          t("RECENT_WORKS.CODEX.5"),
        ]}
      />
    )}
  </TimeLine>

  <!-- Clinpays -->
  <TimeLine
    showTimeline={isPortfolio}
    startDate="11/2014"
    endDate="02/2024"
    location="San Pedro Sula, Honduras"
    date="Nov 2014"
    title="Clinpays"
    subtitle="FullStack Developer / Tech Lead"
  >
    <ClinpaysIcon slot="icon" />
    {isPortfolio ? (
      <WorkDetail
        context={t("RECENT_WORKS.CLINPAYS.CONTEXT")}
        role={t("RECENT_WORKS.CLINPAYS.ROLE")}
        contributions={[
          t("RECENT_WORKS.CLINPAYS.1"),
          t("RECENT_WORKS.CLINPAYS.2"),
          t("RECENT_WORKS.CLINPAYS.3"),
          t("RECENT_WORKS.CLINPAYS.4"),
          t("RECENT_WORKS.CLINPAYS.5"),
        ]}
        challenges={[
          t("RECENT_WORKS.CLINPAYS.CHALLENGE.1"),
          t("RECENT_WORKS.CLINPAYS.CHALLENGE.2"),
          t("RECENT_WORKS.CLINPAYS.CHALLENGE.3"),
        ]}
        results={[
          t("RECENT_WORKS.CLINPAYS.RESULT.1"),
          t("RECENT_WORKS.CLINPAYS.RESULT.2"),
          t("RECENT_WORKS.CLINPAYS.RESULT.3"),
        ]}
        tags={["Paygate", "BIN Routing", "KYC", "3DS", "PCI DSS", "Payments"]}
        {labels}
      />
    ) : (
      <ProjectList
        showTimeline={false}
        title=""
        details={[
          t("RECENT_WORKS.CLINPAYS.1"),
          t("RECENT_WORKS.CLINPAYS.2"),
          t("RECENT_WORKS.CLINPAYS.3"),
          t("RECENT_WORKS.CLINPAYS.4"),
          t("RECENT_WORKS.CLINPAYS.5"),
        ]}
      />
    )}
  </TimeLine>

</div>
