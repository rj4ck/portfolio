---
interface Props {
  title: string;
  role: string;
  role_es?: string;
  location: string;
  collaborator?: string;
  tags?: string[];
  description: string;
  description_es?: string;
  context?: string;
  context_es?: string;
  contributions?: string[];
  contributions_es?: string[];
  results?: string[];
  results_es?: string[];
  lang?: "en" | "es";
}

const {
  title, role, role_es, location, collaborator, tags,
  description, description_es,
  context, context_es,
  contributions, contributions_es,
  results, results_es,
  lang = "en",
} = Astro.props;

const displayRole    = lang === "es" && role_es         ? role_es         : role;
const displayContext = lang === "es" && context_es      ? context_es      : context;
const displayContribs= lang === "es" && contributions_es? contributions_es: contributions;
const displayResults = lang === "es" && results_es      ? results_es      : results;

const isStructured = !!(context || contributions?.length);
---

<div class="group py-7 border-b border-gray-800 last:border-0">
  <div class="mb-2">
    <h3 class="text-2xl sm:text-4xl font-bold text-gray-600 group-hover:text-white transition-colors duration-500 leading-tight">
      {title}
    </h3>
    <span class="text-orange-400 text-xs sm:text-sm font-medium">{displayRole}</span>
  </div>

  <div class="flex flex-wrap gap-x-5 gap-y-1 text-gray-600 text-xs mb-4">
    <span class="flex items-center gap-1.5">
      <i class="fa fa-solid fa-location-dot"></i>
      {location}
    </span>
    {collaborator && (
      <span class="flex items-center gap-1.5">
        <i class="fa fa-solid fa-user" />
        {collaborator}
      </span>
    )}
  </div>

  {isStructured ? (
    <div class="space-y-3">

      {displayContext && (
        <p class="text-sm text-gray-400 leading-relaxed italic">{displayContext}</p>
      )}

      {displayContribs && displayContribs.length > 0 && (
        <ul class="space-y-1.5 mt-1">
          {displayContribs.map((c) => (
            <li class="flex items-start gap-2 text-sm text-gray-300 leading-relaxed">
              <i class="fa fa-solid fa-arrow-right text-orange-500 text-[10px] mt-1.5 shrink-0"></i>
              <span>{c}</span>
            </li>
          ))}
        </ul>
      )}

      {displayResults && displayResults.length > 0 && (
        <div class="flex flex-wrap gap-2 pt-1">
          {displayResults.map((r) => (
            <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-green-950/50 border border-green-800/40 text-green-400 text-xs font-medium">
              <i class="fa fa-solid fa-check text-[9px]"></i>
              {r}
            </span>
          ))}
        </div>
      )}

    </div>
  ) : (
    <p class="text-gray-400 text-sm leading-relaxed max-w-2xl">
      {lang === "es" && description_es ? description_es : description}
    </p>
  )}

  {tags && tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mt-4">
      {tags.map((tag) => (
        <span class="px-2 py-0.5 rounded-md bg-gray-800 border border-gray-700 text-orange-400 text-xs font-medium">
          {tag}
        </span>
      ))}
    </div>
  )}
</div>
