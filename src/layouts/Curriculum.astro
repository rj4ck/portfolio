---
import "@fortawesome/fontawesome-free/css/all.css";
import BaseHead from "../components/BaseHead.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { useTranslations } from "../i18n/utils";

const { lang } = Astro.params;
const t = useTranslations(lang as "en" | "es");
---

<!doctype html>
<html lang={lang}>
  <BaseHead
    title={`${t("CURRICULUM.TITLE")} — Raquel Jackson`}
    description={lang === "es"
      ? "Hoja de vida de Raquel Jackson — Desarrolladora Full Stack con experiencia en ReactJS, VueJS, AWS y sistemas de pago."
      : "Curriculum Vitae of Raquel Jackson — Full Stack Developer with experience in ReactJS, VueJS, AWS and payment systems."}
    lang={lang}
  />

  <body class="w-full h-screen bg-white flex justify-center">
    <LanguageSwitcher lang={lang ?? "en"} />
    <slot />
  </body>
</html>

<style is:global>
  @media print {
    @page {
      size: letter portrait;
      margin: 0.4in 0.5in;
    }

    body {
      background: white !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Full width, no centering overhead */
    .w-\[8\.5in\] {
      width: 100% !important;
    }

    /* Section gaps */
    .mb-4  { margin-bottom: 5pt !important; }
    .my-4  { margin-top: 3pt !important; margin-bottom: 3pt !important; }
    .mt-2  { margin-top: 3pt !important; }
    .gap-2 { gap: 3pt !important; }

    /* Experience list spacing */
    .space-y-6 > * + * { margin-top: 7pt !important; }
    .space-y-1 > * + * { margin-top: 1pt !important; }

    /* Font sizes */
    .text-4xl { font-size: 20pt !important; line-height: 1.2 !important; }
    .text-xl   { font-size: 11pt !important; line-height: 1.3 !important; }
    .text-sm   { font-size: 8.5pt !important; line-height: 1.4 !important; }
    .text-xs   { font-size: 7.5pt !important; line-height: 1.4 !important; }

    /* Padding compression */
    .p-2      { padding: 2pt !important; }
    .py-2     { padding-top: 2pt !important; padding-bottom: 2pt !important; }
    .py-1\.5  { padding-top: 1pt !important; padding-bottom: 1pt !important; }
    .ml-6     { margin-left: 0.8rem !important; }

    /* Borders */
    .border-gray-700 { border-color: #d1d5db !important; }
    .border-b-2.border-black { border-bottom-width: 1.5pt !important; }

    /* Remove decorative shadows */
    .shadow, .shadow-sm, .shadow-md { box-shadow: none !important; }

    /* Page break controls */
    .avoid-break { break-inside: avoid !important; }
    .avoid-break-after { break-after: avoid !important; }
  }
</style>
