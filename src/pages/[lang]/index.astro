---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Sections.astro";
import WorkCard from "../../components/WorkCard.astro";
import TechnicalSkills from "../../components/TechnicalSkills.astro";
import Hero from "../../components/Hero.astro";
import SocialMedia from "../../components/SocialMedia.astro";
import RecentWorks from "../../components/RecentWorks.astro";
import CollaborationCard from "../../components/CollaborationCard.astro";

const technicalSkills = await Astro.glob("../../content/technical-skills/*.md");
const recentProjects = await Astro.glob("../../content/recent-projects/*.md");
const collaborations = await Astro.glob("../../content/collaborations/*.md");
const sortedCollaborations = collaborations
  .filter((c) => !c.frontmatter.draft)
  .sort((a, b) => a.frontmatter.order - b.frontmatter.order);

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const { lang } = Astro.params;
---

<Layout>
  <div class="">
    <header
      class="bg-gray-900 lg:fixed lg:inset-y-0 lg:left-0 lg:flex lg:w-[30rem] lg:items-center lg:overflow-hidden xl:w-[30rem] text-white flex-col justify-between p-6"
    >
      <Hero />
      <div class="mt-6">
        <SocialMedia />
      </div>
    </header>

    <main class="lg:ml-[30rem] overflow-auto px-8 lg:px-16">
      <Section title="Technical skills">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:items-stretch md:grid-cols-3 md:gap-6">
          {
            technicalSkills.map((skill) => (
              <TechnicalSkills title={skill.frontmatter.title} skills={skill.frontmatter.skills} />
            ))
          }
        </div>
      </Section>

      <Section title="Collaborations">
        <div class="max-w-3xl">
          {
            sortedCollaborations.map((item) => (
              <CollaborationCard
                title={item.frontmatter.title}
                role={item.frontmatter.role}
                location={item.frontmatter.location}
                collaborator={item.frontmatter.collaborator}
                tags={item.frontmatter.tags}
                description={item.frontmatter.description}
              />
            ))
          }
        </div>
      </Section>

      <Section title="Personal projects">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 md:gap-6">
          {
            recentProjects.map((project, index) => (
              <div class={`${index === 0 ? "sm:col-span-2" : ""} flex`}>
                <WorkCard
                  title={project?.frontmatter?.title}
                  icon={project?.frontmatter?.icon}
                  createdDate={project?.frontmatter?.createdDate}
                  tags={project?.frontmatter?.tags}
                  links={project?.frontmatter?.links}
                  description={project?.frontmatter?.description}
                  featured={index === 0}
                />
              </div>
            ))
          }
        </div>
      </Section>

      <Section title="Recent works">
        <RecentWorks lang={lang} />
      </Section>
    </main>
  </div>
</Layout>
