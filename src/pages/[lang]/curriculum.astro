---
import CurriculumLayout from "../../layouts/Curriculum.astro";
import Skills from "../../components/Curriculum/Skills.astro";
import Education from "../../components/Curriculum/Education.astro";
import CurriculumSection from "../../components/Curriculum/CurriculumSection.astro";
import { useTranslations } from "../../i18n/utils";
import TimeLine from "../../components/TimeLine.astro";
import ProjectList from "../../components/ProjectList.astro";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as "en" | "es");
---

<CurriculumLayout>
  <div class="bg-white w-[8.5in] h-fit max-w-full mx-auto">
    <header>
      <p class="text-4xl font-bold uppercase">Raquel Jackson</p>
      <p class="text-xl font-semibold text-orange-400">Full Stack Developer</p>

      <div class="grid grid-cols-2 gap-2 my-4">
        <div>
          <p>
            <i class="fa fa-location-dot text-orange-300 mr-0.5"></i>
            San Pedro Sula, Honduras
          </p>
          <p>
            <i class="fa fa-phone text-orange-300 mr-0.5"></i>
            (+504) 3146-1429
          </p>
          <p>
            <i class="fa fa-envelope text-orange-300 mr-0.5"></i>
            r.jackson@msn.com
          </p>
        </div>

        <div>
          <p>
            <i class="fa fa-brands fa-linkedin text-orange-300 mr-0.5"></i>
            <a href="https://linkedin.com/in/raquel-jackson" target="_blank">
              linkedin.com/in/raquel-jackson
            </a>
          </p>
          <p>
            <i class="fa fa-brands fa-github text-orange-300 mr-0.5"></i>
            <a href="https://github.com/rj4ck" target="_blank"> github.com/rj4ck </a>
          </p>
          <p>
            <i class="fa fa-globe text-orange-300 mr-0.5"></i>
            <a href="https://rj4ck.github.io/portfolio" target="_blank">
              rj4ck.github.io/portfolio
            </a>
          </p>
        </div>
      </div>
    </header>

    <CurriculumSection
      title={t("CURRICULUM.SUMMARY.TITLE")}
      content={t("CURRICULUM.SUMMARY.DESCRIPTION")}
    />

    <CurriculumSection title={t("CURRICULUM.EXPERIENCE.TITLE")}>
      <div class="space-y-6">
        <TimeLine
          showTimeline={false}
          startDate={"10/2024"}
          location={"Austin, Texas"}
          date={"Oct 2024"}
          title={"Code ÉXITOS"}
          subtitle={"Software Engineer 2"}
        >
          <ProjectList
            showTimeline={false}
            title={""}
            details={[
              t("RECENT_WORKS.CODEX_2.1"),
              t("RECENT_WORKS.CODEX_2.2"),
              t("RECENT_WORKS.CODEX_2.3"),
              t("RECENT_WORKS.CODEX_2.4"),
              t("RECENT_WORKS.CODEX_2.5"),
              t("RECENT_WORKS.CODEX_2.6"),
            ]}
          />
        </TimeLine>

        <TimeLine
          showTimeline={false}
          startDate={"02/2022"}
          endDate={"01/2024"}
          location={"San Pedro Sula, Honduras"}
          date={"Feb 2022"}
          title={"Code ÉXITOS"}
          subtitle={"Software Developer"}
        >
          <ProjectList
            showTimeline={false}
            title={""}
            details={[
              t("RECENT_WORKS.CODEX.1"),
              t("RECENT_WORKS.CODEX.2"),
              t("RECENT_WORKS.CODEX.3"),
              t("RECENT_WORKS.CODEX.4"),
              t("RECENT_WORKS.CODEX.5"),
              t("RECENT_WORKS.CODEX.6"),
              t("RECENT_WORKS.CODEX.7"),
            ]}
          />
        </TimeLine>

        <TimeLine
          showTimeline={false}
          startDate={"11/2014"}
          endDate={"02/2024"}
          location={"San Pedro Sula, Honduras"}
          date={"Nov 2014"}
          title={"Clinpays"}
          subtitle={"Lead Developer"}
        >
          <ProjectList
            showTimeline={false}
            title={""}
            details={[
              t("RECENT_WORKS.CLINPAYS.1"),
              t("RECENT_WORKS.CLINPAYS.2"),
              t("RECENT_WORKS.CLINPAYS.3"),
              t("RECENT_WORKS.CLINPAYS.4"),
              t("RECENT_WORKS.CLINPAYS.5"),
              t("RECENT_WORKS.CLINPAYS.6"),
            ]}
          />
        </TimeLine>
      </div>
    </CurriculumSection>

    <CurriculumSection title={t("CURRICULUM.SKILLS.TITLE")}>
      <Skills />
    </CurriculumSection>

    <CurriculumSection title={t("CURRICULUM.EDUCATION.TITLE")}>
      <Education />
    </CurriculumSection>

    <CurriculumSection title={t("CURRICULUM.LANGUAGES.TITLE")}>
      <div class="flex gap-8 mt-1 text-sm">
        <span>
          {t("CURRICULUM.LANGUAGES.ES")}
          <span class="text-gray-500 ml-1">{t("CURRICULUM.LANGUAGES.NATIVE")}</span>
        </span>
        <span>
          {t("CURRICULUM.LANGUAGES.EN")}
          <span class="text-gray-500 ml-1">{t("CURRICULUM.LANGUAGES.INTERMEDIATE")}</span>
        </span>
      </div>
    </CurriculumSection>
  </div>
</CurriculumLayout>
